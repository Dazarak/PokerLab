<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="32dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_TokenMain" />

    <TextView
        android:id="@+id/PakerLab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/casino"
        android:text="PokerLab"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/Layer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/startGameButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PakerLab"
        tools:ignore="RtlHardcoded">

        <TextView
            android:id="@+id/startingAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/casino"
            android:text="Starting Amount" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/startingAmount"
                style="@style/EditTextStyle"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@drawable/border_textbar_rounded_corner"
                android:text="50" />

            <SeekBar
                android:id="@+id/startingAmountSeekBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:max="2"
                android:min="0"
                android:progress="1"
                android:rotation="270"
                android:thumb="@drawable/custom_seekbar_thumb" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/arrowupdown" />

        </LinearLayout>

        <TextView
            android:id="@+id/smallBlindLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/casino"
            android:text="Small/Big Blind" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/smallBlind"
                style="@style/EditTextStyle"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:inputType="number"
                android:text="1" />

            <EditText
                android:id="@+id/bigBlind"
                style="@style/EditTextStyle"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="@drawable/border_textbar_rounded_corner"
                android:text="2" />

            <SeekBar
                android:id="@+id/smallBlindSeekBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:max="2"
                android:progress="1"
                android:rotation="270"
                android:thumb="@drawable/custom_seekbar_thumb" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/arrowupdown" />
        </LinearLayout>

        <TextView
            android:id="@+id/numIaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/casino"
            android:text="Number of AI" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/numIa"
                style="@style/EditTextStyle"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:background="@drawable/border_textbar_rounded_corner"
                android:text="2" />

            <SeekBar
                android:id="@+id/numIaSeekBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:max="2"
                android:progress="1"
                android:rotation="270"
                android:thumb="@drawable/custom_seekbar_thumb" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/arrowupdown" />

        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/startGameButton"
        style="@style/ActionButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="Start game"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/startAIGameButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/startAIGameButton"
        style="@style/ActionButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:paddingTop="10dp"
        android:text="Train AI"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/settings" />

    <TextView
        android:id="@+id/tv_TokenMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/casino"
        android:text="TOKENS : 0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>