<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/plateau"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".GameActivity"
    android:layout_alignParentEnd="true"
    >

    <include
        android:id="@+id/iaItem1"
        layout="@layout/ia_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp" />

    <include
        android:id="@+id/iaItem2"
        layout="@layout/ia_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iaItem1" />

    <include
        android:id="@+id/iaItem3"
        layout="@layout/ia_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iaItem2" />

    <include
        android:id="@+id/iaItem4"
        layout="@layout/ia_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iaItem3" />

    <include
        android:id="@+id/iaItem5"
        layout="@layout/ia_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iaItem4" />


    <LinearLayout
        android:id="@+id/communityCardsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/border_community_cards"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/iaItem5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/communityCard1"
            layout="@layout/card_item"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_width="30dp"
            android:layout_height="50dp"   />


        <include
            android:id="@+id/communityCard2"
            layout="@layout/card_item"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_width="30dp"
            android:layout_height="50dp"  />


        <include
            android:id="@+id/communityCard3"
            layout="@layout/card_item"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_width="30dp"
            android:layout_height="50dp"  />


        <include
            android:id="@+id/communityCard4"
            layout="@layout/card_item"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_width="30dp"
            android:layout_height="50dp"  />


        <include
            android:id="@+id/communityCard5"
            layout="@layout/card_item"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_width="30dp"
            android:layout_height="50dp"  />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_PlayerData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/tx_playerPos"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/ll_CardLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/playerCard1"
                layout="@layout/card_item"
                android:layout_width="55dp"
                android:layout_height="90dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <include
                android:id="@+id/playerCard2"
                layout="@layout/card_item"
                android:layout_width="55dp"
                android:layout_height="90dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_playerHand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/casino"
            android:layout_marginTop="5dp"
            android:text="Player Hand: "
            android:textColor="@color/textGame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/PlayerMonney"
            android:layout_width="match_parent"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/casino"
            android:layout_height="wrap_content"
            android:text="Monney : 1€"
            android:textColor="@color/textGame"
            android:textAlignment="viewStart"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/bt_Check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:text="Check"
                android:layout_gravity="end"
                style="@style/GameButtonStyle"/>
            <Button
                android:id="@+id/bt_Call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call"
                android:textSize="16sp"
                android:layout_gravity="end"
                style="@style/GameButtonStyle"/>

            <Button
                android:id="@+id/bt_Fold"
                style="@style/GameButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fold"
                android:textSize="16sp"
                android:layout_gravity="end"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tx_Raise"
                android:fontFamily="@font/casino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 €"
                android:textColor="@color/textGame" />

            <SeekBar
                android:id="@+id/sb_Raise"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:max="1000"
                android:min="1"
                android:progress="1"
                android:progressTint="@color/vertclaire"
                android:rotation="270"
                android:thumb="@drawable/custom_seekbar_thumb_2" />

            <Button
                android:id="@+id/bt_Raise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raise"
                android:textSize="16sp"
                style="@style/GameButtonStyle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tx_playerPos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/casino"
        android:text="Pos : 1"
        android:textColor="@color/textGame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tx_playerBet"
        android:fontFamily="@font/casino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:text="Bet : 0€"
        android:textColor="@color/textGame"
        app:layout_constraintBottom_toTopOf="@+id/ll_PlayerData"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tx_Pot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/casino"
        android:text="Pot : 0 €"
        android:textColor="@color/textGame"
        app:layout_constraintEnd_toEndOf="@+id/communityCardsLayout"
        app:layout_constraintStart_toStartOf="@+id/communityCardsLayout"
        app:layout_constraintTop_toBottomOf="@+id/communityCardsLayout" />

    <TextView
        android:id="@+id/tv_partyNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/casino"
        android:layout_marginTop="5dp"
        android:text="1"
        android:textColor="@color/textGame"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="@+id/ib_exit"
        app:layout_constraintEnd_toStartOf="@+id/ib_exit"
        app:layout_constraintTop_toTopOf="@+id/ib_exit" />

    <ImageView
        android:id="@+id/ib_exit"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/border_community_cards"
        app:srcCompat="?attr/actionModeCloseDrawable"
        app:tint="@color/textGame" />

</androidx.constraintlayout.widget.ConstraintLayout>